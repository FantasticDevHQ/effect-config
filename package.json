{
  "name": "@fantastic.dev/effect-config",
  "version": "0.1.1",
  "description": "Typed configuration keys for Effect: one key list, Effect Config, drift checks and an optional Doppler ConfigProvider.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasticDevHQ/effect-config.git"
  },
  "homepage": "https://github.com/FantasticDevHQ/effect-config#readme",
  "bugs": {
    "url": "https://github.com/FantasticDevHQ/effect-config/issues"
  },
  "keywords": [
    "effect",
    "config",
    "configuration",
    "env",
    "dotenv",
    "doppler"
  ],
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./doppler": {
      "types": "./dist/doppler/index.d.ts",
      "default": "./dist/doppler/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/fantastic-dev-logo.svg"
  ],
  "scripts": {
    "build": "effect-tsgo tsc -p tsconfig.build.json",
    "typecheck": "effect-tsgo tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pr-standard": "node --test scripts/pr-standard.test.mjs scripts/enforce-pr-standard.test.mjs",
    "test:repo": "node --test scripts/repository.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm test:types && pnpm test:pr-standard && pnpm test:repo && pnpm test:release",
    "test:types": "vitest run --typecheck.only",
    "test:release": "node --test scripts/release/*.test.mjs"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "@distilled.cloud/doppler": "^1.0.0-rc.20"
  },
  "devDependencies": {
    "@distilled.cloud/doppler": "1.0.0-rc.20",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@types/node": "22.20.5",
    "effect": "4.1.4",
    "esbuild": "0.27.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4"
  },
  "bin": {
    "effect-config": "./dist/cli/main.js"
  },
  "peerDependenciesMeta": {
    "@distilled.cloud/doppler": {
      "optional": true
    }
  }
}
